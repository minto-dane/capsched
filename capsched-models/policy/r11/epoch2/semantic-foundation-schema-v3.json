{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainlease.invalid/schema/r11-g0-semantic-foundation-v3.json",
  "title": "DomainLease R11 epoch-2 K0 semantic foundation v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "language_id",
    "status",
    "gate",
    "normative_spec",
    "denotation_clauses",
    "signature_namespaces",
    "sort_forms",
    "term_judgments",
    "base_expression_forms",
    "model_entities",
    "extensions",
    "obligation_families",
    "finite_claim_boundary",
    "backend_boundary",
    "authorization"
  ],
  "properties": {
    "schema_version": {"const": 3},
    "artifact_id": {"const": "domainlease-r11-k0-semantic-foundation-v3"},
    "language_id": {"const": "DL-SemFoundation-3"},
    "status": {"const": "local_K0_candidate_external_adoption_absent"},
    "gate": {"const": "K0_G0_FOUNDATION"},
    "normative_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role", "interpreter_defines_semantics"],
      "properties": {
        "path": {"const": "capsched-models/policy/r11/epoch2/semantic-foundation-v3.md"},
        "role": {"const": "primary_mathematical_denotation"},
        "interpreter_defines_semantics": {"const": false}
      }
    },
    "denotation_clauses": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "items": {"$ref": "#/$defs/clause"}
    },
    "signature_namespaces": {"$ref": "#/$defs/uniqueIds"},
    "sort_forms": {
      "type": "array",
      "minItems": 9,
      "items": {"$ref": "#/$defs/namedRule"}
    },
    "term_judgments": {
      "type": "array",
      "minItems": 6,
      "items": {"$ref": "#/$defs/namedRule"}
    },
    "base_expression_forms": {
      "type": "array",
      "minItems": 20,
      "items": {"$ref": "#/$defs/expression"}
    },
    "model_entities": {
      "type": "array",
      "minItems": 8,
      "items": {"$ref": "#/$defs/namedRule"}
    },
    "extensions": {
      "type": "array",
      "minItems": 5,
      "items": {"$ref": "#/$defs/namedRule"}
    },
    "obligation_families": {
      "type": "array",
      "minItems": 10,
      "items": {"$ref": "#/$defs/namedRule"}
    },
    "finite_claim_boundary": {"type": "object", "minProperties": 1},
    "backend_boundary": {"type": "object", "minProperties": 1},
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local_K0_candidate", "external_K0_adoption", "candidate_IR", "semantic_freeze", "TLA_translation", "model_supported", "linux_behavior_change", "protection_claim"],
      "properties": {
        "local_K0_candidate": {"const": true},
        "external_K0_adoption": {"const": false},
        "candidate_IR": {"const": false},
        "semantic_freeze": {"const": false},
        "TLA_translation": {"const": false},
        "model_supported": {"const": false},
        "linux_behavior_change": {"const": false},
        "protection_claim": {"const": false}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]*$"},
    "uniqueIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "clause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "normative"],
      "properties": {
        "id": {"type": "string", "pattern": "^SF-DEN-[0-9]{3}$"},
        "title": {"type": "string", "minLength": 1},
        "normative": {"const": true}
      }
    },
    "namedRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "clause"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "clause": {"type": "string", "pattern": "^SF-DEN-[0-9]{3}$"},
        "notes": {"type": "string"}
      }
    },
    "expression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "clause", "total", "read_effect"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "clause": {"type": "string", "pattern": "^SF-DEN-[0-9]{3}$"},
        "total": {"const": true},
        "read_effect": {"enum": ["NONE", "PRE", "POST", "EVENT", "COMPOSITIONAL"]},
        "result": {"type": "string"}
      }
    }
  }
}
