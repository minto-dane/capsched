{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainlease.invalid/schema/r11-g0-semantic-kernel-contract-v2.json",
  "title": "DomainLease R11 G0 epoch-2 semantic-kernel contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "language_id",
    "status",
    "owner_role",
    "predecessor",
    "normative_boundary",
    "canonical_encoding",
    "limits",
    "contexts",
    "sort_kinds",
    "operators",
    "structured_obligations",
    "template_system",
    "state_product_system",
    "conformance",
    "reject_taxonomy",
    "authorization"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "artifact_id": {"const": "domainlease-r11-g0-semantic-kernel-contract-v2"},
    "language_id": {"const": "DL-SemKernel-2"},
    "status": {"const": "local_draft_external_adoption_required"},
    "owner_role": {"const": "ROLE-EXTERNAL-SEMANTIC-AUTHORITY"},
    "predecessor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_sha256", "disposition", "analysis", "validation"],
      "properties": {
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "disposition": {"const": "rejected_before_external_review"},
        "analysis": {"const": "0214"},
        "validation": {"const": "0303"}
      }
    },
    "normative_boundary": {"$ref": "#/$defs/nonEmptyObject"},
    "canonical_encoding": {"$ref": "#/$defs/nonEmptyObject"},
    "limits": {"$ref": "#/$defs/nonEmptyObject"},
    "contexts": {
      "type": "array",
      "minItems": 8,
      "items": {"$ref": "#/$defs/context"}
    },
    "sort_kinds": {
      "type": "array",
      "minItems": 10,
      "items": {"$ref": "#/$defs/sortKind"}
    },
    "operators": {
      "type": "array",
      "minItems": 30,
      "items": {"$ref": "#/$defs/operator"}
    },
    "structured_obligations": {
      "type": "array",
      "minItems": 7,
      "items": {"$ref": "#/$defs/structuredItem"}
    },
    "template_system": {"$ref": "#/$defs/nonEmptyObject"},
    "state_product_system": {"$ref": "#/$defs/nonEmptyObject"},
    "conformance": {"$ref": "#/$defs/nonEmptyObject"},
    "reject_taxonomy": {
      "type": "array",
      "minItems": 15,
      "items": {"$ref": "#/$defs/reject"}
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_contract_draft",
        "external_adoption",
        "g0_complete",
        "candidate_machine_ir",
        "semantic_freeze",
        "tla_translation",
        "model_supported",
        "linux_behavior_change",
        "protection_claim"
      ],
      "properties": {
        "local_contract_draft": {"const": true},
        "external_adoption": {"const": false},
        "g0_complete": {"const": false},
        "candidate_machine_ir": {"const": false},
        "semantic_freeze": {"const": false},
        "tla_translation": {"const": false},
        "model_supported": {"const": false},
        "linux_behavior_change": {"const": false},
        "protection_claim": {"const": false}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "uniqueIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "nonEmptyObject": {"type": "object", "minProperties": 1},
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ast_allowed",
        "pre_state",
        "post_state",
        "action_parameters",
        "bounded_quantifiers",
        "result_constraint"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "ast_allowed": {"type": "boolean"},
        "pre_state": {"type": "boolean"},
        "post_state": {"type": "boolean"},
        "action_parameters": {"type": "boolean"},
        "bounded_quantifiers": {"type": "boolean"},
        "result_constraint": {"type": "string", "minLength": 1},
        "notes": {"type": "string"}
      }
    },
    "sortKind": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "finite", "semantic_rule"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "finite": {"const": true},
        "semantic_rule": {"type": "string", "minLength": 1},
        "required_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "forbidden_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "arity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": {"type": "integer", "minimum": 0},
        "maximum": {"type": "integer", "minimum": 0}
      }
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "arity",
        "allowed_contexts",
        "operand_rule",
        "result_rule",
        "evaluation_rule",
        "total"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "arity": {"$ref": "#/$defs/arity"},
        "allowed_contexts": {"$ref": "#/$defs/uniqueIds"},
        "operand_rule": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]*$"},
        "result_rule": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]*$"},
        "evaluation_rule": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]*$"},
        "total": {"const": true}
      }
    },
    "structuredItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "required_fields", "semantic_checks"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "required_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "semantic_checks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "reject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "meaning"],
      "properties": {
        "id": {"type": "string", "pattern": "^SK-[A-Z0-9-]+$"},
        "meaning": {"type": "string", "minLength": 1}
      }
    }
  }
}
