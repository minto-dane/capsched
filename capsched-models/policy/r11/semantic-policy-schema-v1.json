{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domainlease.invalid/schema/r11-semantic-policy-v1.json",
  "title": "DomainLease R11 external semantic policy candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "policy_epoch",
    "status",
    "project",
    "requirement",
    "applies_to_model_revision",
    "owner_role",
    "predecessor_disposition",
    "claim_boundary",
    "threat_model",
    "trust_roles",
    "state_classes",
    "consistency_domains",
    "authority_kinds",
    "authority_separation_rules",
    "resource_algebra",
    "identity_policy",
    "semantic_dag",
    "bootstrap_policy",
    "async_policy",
    "transaction_policy",
    "physical_entry_policy",
    "revocation_and_offline_policy",
    "settlement_policy",
    "transfer_policy",
    "provider_contracts",
    "invariant_obligations",
    "progress_obligations",
    "formalization_rules",
    "mutation_oracle",
    "authorization"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_id": {"const": "domainlease-r11-semantic-policy-v1"},
    "policy_epoch": {"const": 1},
    "status": {"const": "draft_pending_independent_review"},
    "project": {"const": "DomainLease-Linux"},
    "requirement": {"const": "RESIDENCY-DYN-001"},
    "applies_to_model_revision": {"const": "R11"},
    "owner_role": {"const": "external_semantic_policy_authority"},
    "predecessor_disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "status", "decision", "analysis"],
      "properties": {
        "model": {"const": "DynamicResidencyR10"},
        "status": {"const": "rejected_self_attested_semantics"},
        "decision": {"const": "ADR-0016"},
        "analysis": {"const": "0213"}
      }
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assurance_claims", "policy_claims", "nonclaims"],
      "properties": {
        "assurance_claims": {"$ref": "#/$defs/nonemptyUniqueStrings"},
        "policy_claims": {"$ref": "#/$defs/nonemptyUniqueStrings"},
        "nonclaims": {"$ref": "#/$defs/nonemptyUniqueStrings"}
      }
    },
    "threat_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adversarial_principals", "trusted_assumptions", "explicitly_untrusted_inputs"],
      "properties": {
        "adversarial_principals": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/actor"}},
        "trusted_assumptions": {"$ref": "#/$defs/nonemptyUniqueStrings"},
        "explicitly_untrusted_inputs": {"$ref": "#/$defs/nonemptyUniqueStrings"}
      }
    },
    "trust_roles": {"type": "array", "minItems": 10, "items": {"$ref": "#/$defs/trustRole"}},
    "state_classes": {"type": "array", "minItems": 7, "items": {"$ref": "#/$defs/stateClass"}},
    "consistency_domains": {"type": "array", "minItems": 10, "items": {"$ref": "#/$defs/consistencyDomain"}},
    "authority_kinds": {"type": "array", "minItems": 12, "items": {"$ref": "#/$defs/authorityKind"}},
    "authority_separation_rules": {"type": "array", "minItems": 7, "items": {"$ref": "#/$defs/idRule"}},
    "resource_algebra": {"$ref": "#/$defs/resourceAlgebra"},
    "identity_policy": {"$ref": "#/$defs/identityPolicy"},
    "semantic_dag": {"type": "array", "minItems": 18, "maxItems": 18, "items": {"$ref": "#/$defs/dagNode"}},
    "bootstrap_policy": {"$ref": "#/$defs/bootstrapPolicy"},
    "async_policy": {"$ref": "#/$defs/asyncPolicy"},
    "transaction_policy": {"$ref": "#/$defs/transactionPolicy"},
    "physical_entry_policy": {"$ref": "#/$defs/physicalEntryPolicy"},
    "revocation_and_offline_policy": {"$ref": "#/$defs/revocationPolicy"},
    "settlement_policy": {"$ref": "#/$defs/settlementPolicy"},
    "transfer_policy": {"$ref": "#/$defs/transferPolicy"},
    "provider_contracts": {"type": "array", "minItems": 10, "items": {"$ref": "#/$defs/providerContract"}},
    "invariant_obligations": {"type": "array", "minItems": 27, "maxItems": 27, "items": {"$ref": "#/$defs/invariantObligation"}},
    "progress_obligations": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/progressObligation"}},
    "formalization_rules": {"$ref": "#/$defs/formalizationRules"},
    "mutation_oracle": {"$ref": "#/$defs/mutationOracle"},
    "authorization": {"$ref": "#/$defs/authorization"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"},
    "nonemptyString": {"type": "string", "minLength": 1},
    "nonemptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonemptyString"}
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "power", "may_control_scheduling_policy", "fairness_assumed"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "power": {"$ref": "#/$defs/nonemptyString"},
        "may_control_scheduling_policy": {"type": "boolean"},
        "fairness_assumed": {"const": false}
      }
    },
    "trustRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "class", "may_write_state_classes", "may_make_current_executable", "compromise_in_scope"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "class": {"$ref": "#/$defs/id"},
        "may_write_state_classes": {"$ref": "#/$defs/nonemptyUniqueStrings"},
        "may_make_current_executable": {"type": "boolean"},
        "compromise_in_scope": {"type": "boolean"}
      }
    },
    "stateClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "authoritative", "runtime_mutable", "allowed_writer_roles"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "authoritative": {"type": "boolean"},
        "runtime_mutable": {"type": "boolean"},
        "allowed_writer_roles": {"$ref": "#/$defs/nonemptyUniqueStrings"}
      }
    },
    "consistencyDomain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "axes"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "axes": {"$ref": "#/$defs/nonemptyUniqueStrings"}
      }
    },
    "authorityKind": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "permits", "forbids"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "permits": {"$ref": "#/$defs/nonemptyUniqueStrings"},
        "forbids": {"$ref": "#/$defs/nonemptyUniqueStrings"}
      }
    },
    "idRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rule"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "rule": {"$ref": "#/$defs/nonemptyString"}
      }
    },
    "resourceComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "unit", "burn_allowed"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "unit": {"$ref": "#/$defs/nonemptyString"},
        "burn_allowed": {"type": "boolean"}
      }
    },
    "conservationEquation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "right", "operator"],
      "properties": {
        "left": {"$ref": "#/$defs/nonemptyUniqueStrings"},
        "right": {"$ref": "#/$defs/nonemptyUniqueStrings"},
        "operator": {"const": "componentwise_equality"}
      }
    },
    "resourceAlgebra": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value_domain", "comparison", "addition", "subtraction", "components", "disjoint_buckets", "conservation_equation", "burn_policy", "issue_policy", "accounting_policy"],
      "properties": {
        "value_domain": {"const": "bounded_natural_numbers"},
        "comparison": {"const": "componentwise_less_than_or_equal"},
        "addition": {"const": "componentwise_checked_addition"},
        "subtraction": {"const": "componentwise_guarded_subtraction_rejecting_underflow"},
        "components": {"type": "array", "minItems": 12, "items": {"$ref": "#/$defs/resourceComponent"}},
        "disjoint_buckets": {"type": "array", "minItems": 10, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "conservation_equation": {"$ref": "#/$defs/conservationEquation"},
        "burn_policy": {"$ref": "#/$defs/nonemptyString"},
        "issue_policy": {"$ref": "#/$defs/nonemptyString"},
        "accounting_policy": {"$ref": "#/$defs/nonemptyString"}
      }
    },
    "identityPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity_spaces", "reuse_rule", "generation_rule", "overflow_rule", "alias_rule"],
      "properties": {
        "identity_spaces": {"type": "array", "minItems": 25, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "reuse_rule": {"$ref": "#/$defs/nonemptyString"},
        "generation_rule": {"$ref": "#/$defs/nonemptyString"},
        "overflow_rule": {"$ref": "#/$defs/nonemptyString"},
        "alias_rule": {"$ref": "#/$defs/nonemptyString"}
      }
    },
    "dagNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "predecessors", "meaning"],
      "properties": {
        "id": {"pattern": "^D(?:[0-9]|1[0-7])$"},
        "predecessors": {"type": "array", "uniqueItems": true, "items": {"pattern": "^D(?:[0-9]|1[0-7])$"}},
        "meaning": {"$ref": "#/$defs/nonemptyString"}
      }
    },
    "bootstrapPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initial_executable_count", "boot_root_is_domain", "boot_root_is_executable", "management_path_must_include", "tenant_gate_opens_after"],
      "properties": {
        "initial_executable_count": {"const": 0},
        "boot_root_is_domain": {"const": false},
        "boot_root_is_executable": {"const": false},
        "management_path_must_include": {"type": "array", "minItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "tenant_gate_opens_after": {"$ref": "#/$defs/nonemptyString"}
      }
    },
    "asyncPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["distinct_authorities", "aliased_authority", "single_use_role_fusion", "budget_accounting", "effective_endpoint_authority", "worker_current_is_authority", "carrier_rule", "coalescing_rule", "terminal_rule"],
      "properties": {
        "distinct_authorities": {"$ref": "#/$defs/nonemptyString"},
        "aliased_authority": {"$ref": "#/$defs/nonemptyString"},
        "single_use_role_fusion": {"const": "forbidden"},
        "budget_accounting": {"$ref": "#/$defs/nonemptyString"},
        "effective_endpoint_authority": {"$ref": "#/$defs/nonemptyString"},
        "worker_current_is_authority": {"const": false},
        "carrier_rule": {"$ref": "#/$defs/nonemptyString"},
        "coalescing_rule": {"$ref": "#/$defs/nonemptyString"},
        "terminal_rule": {"$ref": "#/$defs/nonemptyString"}
      }
    },
    "transactionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["atomicity_scope", "cross_domain_rule", "cross_domain_protocol", "maximum_atomic_locations", "required_phases", "crash_rule", "projection_rule", "publication_rule"],
      "properties": {
        "atomicity_scope": {"const": "one_declared_consistency_domain"},
        "cross_domain_rule": {"$ref": "#/$defs/nonemptyString"},
        "cross_domain_protocol": {"$ref": "#/$defs/crossDomainProtocol"},
        "maximum_atomic_locations": {"type": "integer", "minimum": 1, "maximum": 64},
        "required_phases": {"type": "array", "minItems": 7, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "crash_rule": {"$ref": "#/$defs/nonemptyString"},
        "projection_rule": {"$ref": "#/$defs/nonemptyString"},
        "publication_rule": {"$ref": "#/$defs/nonemptyString"}
      }
    },
    "crossDomainProtocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_step", "in_transit_bucket", "destination_step", "duplicate_consume", "abort_or_expiry", "remote_atomic_write"],
      "properties": {
        "source_step": {"$ref": "#/$defs/nonemptyString"},
        "in_transit_bucket": {"const": "fenced_export"},
        "destination_step": {"$ref": "#/$defs/nonemptyString"},
        "duplicate_consume": {"$ref": "#/$defs/nonemptyString"},
        "abort_or_expiry": {"$ref": "#/$defs/nonemptyString"},
        "remote_atomic_write": {"const": false}
      }
    },
    "physicalEntryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_executable_writer", "only_success_action_class", "initial_entry_authority", "continuation_token_input_to_initial_entry", "legacy_RunToken_interpretation", "required_inputs", "success_receipt", "failure_receipt", "continuation_token_issuer", "continuation_token_condition", "ready_consumed_truth_source", "observation_is_authority", "root_claim_is_execution", "prepare_is_execution", "resume_rule"],
      "properties": {
        "current_executable_writer": {"const": "ROLE-CPU-ENTRY-PROVIDER"},
        "only_success_action_class": {"const": "PROVIDER-COMMIT-ENTRY"},
        "initial_entry_authority": {"const": "fresh_one_use_EntryPermit"},
        "continuation_token_input_to_initial_entry": {"const": false},
        "legacy_RunToken_interpretation": {"$ref": "#/$defs/nonemptyString"},
        "required_inputs": {"type": "array", "minItems": 15, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "success_receipt": {"const": "EnteredReceipt"},
        "failure_receipt": {"const": "NeverEnteredReceipt"},
        "continuation_token_issuer": {"const": "ROLE-CPU-ENTRY-PROVIDER"},
        "continuation_token_condition": {"$ref": "#/$defs/nonemptyString"},
        "ready_consumed_truth_source": {"const": "matching_EnteredReceipt_only"},
        "observation_is_authority": {"const": false},
        "root_claim_is_execution": {"const": false},
        "prepare_is_execution": {"const": false},
        "resume_rule": {"$ref": "#/$defs/nonemptyString"}
      }
    },
    "settlementPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_identity", "required_receipt_set", "ledger_plan", "apply_key", "apply_rule", "completion_rule", "refund_rule", "cross_domain_atomic_apply", "role_alias_changes_ledger_plan"],
      "properties": {
        "root_identity": {"$ref": "#/$defs/nonemptyString"},
        "required_receipt_set": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "ledger_plan": {"$ref": "#/$defs/nonemptyString"},
        "apply_key": {"$ref": "#/$defs/nonemptyString"},
        "apply_rule": {"$ref": "#/$defs/nonemptyString"},
        "completion_rule": {"$ref": "#/$defs/nonemptyString"},
        "refund_rule": {"$ref": "#/$defs/nonemptyString"},
        "cross_domain_atomic_apply": {"const": false},
        "role_alias_changes_ledger_plan": {"const": false}
      }
    },
    "revocationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_effect", "active_entry_bound", "effective_condition", "reuse_condition", "cpu_offline", "failure_close", "late_fact"],
      "properties": {
        "request_effect": {"$ref": "#/$defs/nonemptyString"},
        "active_entry_bound": {"$ref": "#/$defs/nonemptyString"},
        "effective_condition": {"$ref": "#/$defs/nonemptyString"},
        "reuse_condition": {"$ref": "#/$defs/nonemptyString"},
        "cpu_offline": {"$ref": "#/$defs/nonemptyString"},
        "failure_close": {"$ref": "#/$defs/nonemptyString"},
        "late_fact": {"$ref": "#/$defs/nonemptyString"}
      }
    },
    "transferPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_first", "strong_path", "safe_gap_path", "continuity_loss_path", "network_silence_is_quiescence", "destination_install_count", "dual_source_destination_active_authority", "remote_atomic_mutable_state"],
      "properties": {
        "source_first": {"$ref": "#/$defs/nonemptyString"},
        "strong_path": {"$ref": "#/$defs/nonemptyString"},
        "safe_gap_path": {"$ref": "#/$defs/nonemptyString"},
        "continuity_loss_path": {"$ref": "#/$defs/nonemptyString"},
        "network_silence_is_quiescence": {"const": false},
        "destination_install_count": {"const": 1},
        "dual_source_destination_active_authority": {"const": false},
        "remote_atomic_mutable_state": {"const": false}
      }
    },
    "providerContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "writer_role", "receipt_state_class", "trigger", "prestate", "success_relation", "success_receipt", "fault_partition", "failure_successor", "bound_class", "fairness_class", "consumer_obligations", "receipt_initial", "write_once"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "writer_role": {"$ref": "#/$defs/id"},
        "receipt_state_class": {"enum": ["monitor_immutable_receipt", "provider_immutable_receipt"]},
        "trigger": {"$ref": "#/$defs/nonemptyString"},
        "prestate": {"$ref": "#/$defs/nonemptyString"},
        "success_relation": {"$ref": "#/$defs/nonemptyString"},
        "success_receipt": {"$ref": "#/$defs/id"},
        "fault_partition": {"$ref": "#/$defs/nonemptyString"},
        "failure_successor": {"$ref": "#/$defs/id"},
        "bound_class": {"$ref": "#/$defs/id"},
        "fairness_class": {"$ref": "#/$defs/id"},
        "consumer_obligations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"pattern": "^INV-[A-Z0-9-]+$"}},
        "receipt_initial": {"type": "string", "minLength": 1},
        "write_once": {"const": true}
      }
    },
    "invariantObligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "class", "witnesses"],
      "properties": {
        "id": {"pattern": "^INV-[A-Z0-9-]+$"},
        "class": {"enum": ["generated_structural", "generated_safety", "generated_equation", "formal_safety", "noninterference"]},
        "witnesses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"pattern": "^W(?:[0-9]|1[0-2])$"}}
      }
    },
    "progressObligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rely", "success", "witnesses"],
      "properties": {
        "id": {"pattern": "^PROG-[A-Z0-9-]+$"},
        "rely": {"$ref": "#/$defs/nonemptyString"},
        "success": {"$ref": "#/$defs/nonemptyString"},
        "witnesses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"pattern": "^W(?:[0-9]|1[0-2])$"}}
      }
    },
    "formalizationRules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_proof_nodes_are_obligations_not_results", "candidate_preserved_by_lists_are_evidence", "simultaneous_invariant_required", "generated_obligations", "free_formula_rule", "imports_rule", "tla_order"],
      "properties": {
        "candidate_proof_nodes_are_obligations_not_results": {"const": true},
        "candidate_preserved_by_lists_are_evidence": {"const": false},
        "simultaneous_invariant_required": {"const": true},
        "generated_obligations": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/nonemptyString"}},
        "free_formula_rule": {"$ref": "#/$defs/nonemptyString"},
        "imports_rule": {"$ref": "#/$defs/nonemptyString"},
        "tla_order": {"const": "translation_only_after_architecture_and_machine_semantics_freeze"}
      }
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "weakening", "expected_reject"],
      "properties": {
        "id": {"pattern": "^MUT-POL-[A-Z0-9-]+$"},
        "weakening": {"$ref": "#/$defs/nonemptyString"},
        "expected_reject": {"pattern": "^CAT-[A-Z0-9-]+$"}
      }
    },
    "g0Mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "operation", "expected_reject"],
      "properties": {
        "id": {"pattern": "^MUT-G0-[A-Z0-9-]+$"},
        "target": {"enum": ["policy", "profile", "policy_or_profile", "policy_or_profile_raw_bytes", "checker", "review_manifest"]},
        "operation": {"$ref": "#/$defs/nonemptyString"},
        "expected_reject": {"pattern": "^(?:CAT|HM)-[A-Z0-9-]+$"}
      }
    },
    "mutationOracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["g0_policy_profile_templates", "future_ir_mutation_templates", "exact_g0_campaign_materialized", "future_ir_campaign_materialized"],
      "properties": {
        "g0_policy_profile_templates": {"type": "array", "minItems": 12, "items": {"$ref": "#/$defs/g0Mutation"}},
        "future_ir_mutation_templates": {"type": "array", "minItems": 24, "items": {"$ref": "#/$defs/mutation"}},
        "exact_g0_campaign_materialized": {"const": false},
        "future_ir_campaign_materialized": {"const": false}
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_construction_complete", "independent_review_complete", "scenario_profile_accepted", "g0_complete", "r11_machine_ir_authorized", "semantic_freeze", "tla_translation", "model_supported", "linux_behavior_change", "protection_claim"],
      "properties": {
        "policy_construction_complete": {"type": "boolean"},
        "independent_review_complete": {"type": "boolean"},
        "scenario_profile_accepted": {"type": "boolean"},
        "g0_complete": {"type": "boolean"},
        "r11_machine_ir_authorized": {"type": "boolean"},
        "semantic_freeze": {"type": "boolean"},
        "tla_translation": {"type": "boolean"},
        "model_supported": {"type": "boolean"},
        "linux_behavior_change": {"type": "boolean"},
        "protection_claim": {"type": "boolean"}
      }
    }
  }
}
