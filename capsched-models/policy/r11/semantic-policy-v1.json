  "bootstrap_policy": {
    "initial_executable_count": 0,
    "boot_root_is_domain": false,
    "boot_root_is_executable": false,
    "management_path_must_include": ["authority", "activation", "context", "eligibility", "root_claim", "provider_entry", "stop", "settlement"],
    "tenant_gate_opens_after": "ordinary_management_entry_has_stopped_and_settled_with_a_valid_management_admission_receipt"
  },
  "async_policy": {
    "distinct_authorities": "reserve_one_fresh_caller_role_ordinal_and_one_fresh_service_role_ordinal",
    "aliased_authority": "reserve_two_distinct_role_ordinals_from_one_account_in_one_aggregate_account_write",
    "single_use_role_fusion": "forbidden",
    "budget_accounting": "selected_by_fixed_ledger_plan_independently_of_role_aliasing",
    "effective_endpoint_authority": "intersection_of_service_authority_and_frozen_caller_authority",
    "worker_current_is_authority": false,
    "carrier_rule": "domain_derived_async_work_uses_an_immutable_typed_carrier_or_a_policy_defined_lossless_aggregate",
    "coalescing_rule": "a_pending_work_coalesce_must_atomically_preserve_each_use_or_reject_and_refund_it_and_must_never_overwrite_authority_or_budget",
    "terminal_rule": "every_reserved_role_and_budget_use_reaches_exactly_one_commit_refund_or_authorized_burn_terminal"
  },
  "transaction_policy": {
    "atomicity_scope": "one_declared_consistency_domain",
    "cross_domain_rule": "transactions_cross_consistency_domains_only_by_prepare_commit_receipt_fence_or_compensating_protocol",
    "cross_domain_protocol": {
      "source_step": "source_owner_reserves_once_and_emits_an_immutable_export_receipt",
      "in_transit_bucket": "fenced_export",
      "destination_step": "destination_owner_idempotently_consumes_the_exact_export_receipt",
      "duplicate_consume": "same_idempotency_key_returns_the_original_apply_receipt_without_new_effect",
      "abort_or_expiry": "source_owner_refunds_only_after_nonconsumption_is_proved_or_the_destination_horizon_is_closed",
      "remote_atomic_write": false
    },
