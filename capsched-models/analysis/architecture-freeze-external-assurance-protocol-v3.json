    "review_acceptance": "exactly_4_of_4_unique_assignments_accept",
    "semantic_runners": {
      "population": 3,
      "matching_success_threshold": 2,
      "independent_policy_pinned_principals_required": true
    },
    "checkpoint_witnesses": {
      "population": 4,
      "signature_threshold": 3,
      "maximum_Byzantine": 1
    },
    "decision_authorities": {
      "population": 3,
      "signature_threshold": 2
    },
    "candidate_seals": {
      "required_roles": [
        "author",
        "independent_custodian"
