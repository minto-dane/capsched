  "invariants": [
    {"id": "CAP-INV-001", "statement": "The candidate UID is disjoint from every snapshot, capture, reducer, and finalization authority UID.", "enforced_by": ["PLAT-DEDICATED-UID", "roles"]},
    {"id": "CAP-INV-002", "statement": "The candidate has no writable path, inherited descriptor, alias, or mount to captured inputs or evidence; fd 0 is read-only /dev/null and all other inherited descriptors are enumerated.", "enforced_by": ["PLAT-MOUNT-NAMESPACE", "PLAT-ROOT-OWNED-STORAGE", "PLAT-PREEXEC-ATTESTATION", "input_snapshot"]},
    {"id": "CAP-INV-003", "statement": "Every component leader is in its final cgroup before any candidate instruction executes.", "enforced_by": ["PLAT-CLONE-INTO-CGROUP", "containment"]},
    {"id": "CAP-INV-004", "statement": "All descendants remain in the component cgroup because candidate cgroup delegation and cgroupfs writes are absent.", "enforced_by": ["PLAT-CGROUP2-UNIFIED", "containment"]},
    {"id": "CAP-INV-005", "statement": "A process group, session, leader PID, or candidate receipt is never used as the descendant containment oracle.", "enforced_by": ["PLAT-CGROUP-EVENTS", "PLAT-CGROUP-KILL", "containment"]},
    {"id": "CAP-INV-006", "statement": "Leader lifecycle is observed through a supervisor-owned pidfd and waitid rather than candidate output.", "enforced_by": ["PLAT-PIDFD-WAITID", "observation"]},
    {"id": "CAP-INV-007", "statement": "Timeout, signal, leader exit with descendants, output overflow, or supervisor failure initiates cgroup kill and bounded drain.", "enforced_by": ["PLAT-CGROUP-KILL", "PLAT-SUPERVISOR-GUARDIAN", "failure_taxonomy"]},
    {"id": "CAP-INV-008", "statement": "No candidate UID is reused and no final disposition is published before populated equals zero for every launched component cgroup.", "enforced_by": ["PLAT-CGROUP-EVENTS", "containment"]},
    {"id": "CAP-INV-009", "statement": "The root supervisor captures raw stdout and stderr bytes directly from pipes it opened.", "enforced_by": ["observation"]},
    {"id": "CAP-INV-010", "statement": "Candidate-authored aggregate receipts are untrusted data and cannot replace root-captured component receipts.", "enforced_by": ["observation", "positive_eligibility"]},
    {"id": "CAP-INV-011", "statement": "The component set, order, argv, environment, timeouts, and limits come from a sealed root-owned plan and cannot be narrowed by the candidate.", "enforced_by": ["component_plan", "resource_policy"]},
    {"id": "CAP-INV-012", "statement": "Every required source object is opened nonblocking and no-follow, rejected unless regular and single-link before read, captured once through that descriptor, and bound into one input-root digest before launch.", "enforced_by": ["input_snapshot"]},
    {"id": "CAP-INV-013", "statement": "Input write prevention is enforced by authority separation and read-only mounts, not inferred only from equal pre/post hashes.", "enforced_by": ["PLAT-DEDICATED-UID", "PLAT-MOUNT-NAMESPACE", "input_snapshot"]},
    {"id": "CAP-INV-014", "statement": "Network silence, process-group emptiness, or leader exit is never treated as cgroup drain or source quiescence.", "enforced_by": ["PLAT-CGROUP-EVENTS", "containment"]},
    {"id": "CAP-INV-015", "statement": "Output limit, timeout, RAM exhaustion, bounded external-memory exhaustion, unknown termination, or missing raw bytes cannot produce a positive local disposition.", "enforced_by": ["failure_taxonomy", "resource_policy", "positive_eligibility"]},
    {"id": "CAP-INV-016", "statement": "Every raw receipt binds component identity, plan, inputs, exact pre-exec observation, environment, lifecycle, bytes, RAM counters, bounded external-memory setup and cleanup, and drain evidence.", "enforced_by": ["observation", "finalization"]},
    {"id": "CAP-INV-017", "statement": "The post-run reducer reads only finalized root-captured bytes and never reopens the producer workspace.", "enforced_by": ["finalization"]},
    {"id": "CAP-INV-018", "statement": "Reducer output cannot mutate the capture manifest or raw receipts and receives a distinct digest and identity.", "enforced_by": ["finalization"]},
    {"id": "CAP-INV-019", "statement": "Publication is no-replace, file-and-directory-fsynced, content-addressed, inaccessible for candidate mutation, and incomplete until a later durable commit marker binds it.", "enforced_by": ["PLAT-ATOMIC-DURABILITY", "finalization"]},
    {"id": "CAP-INV-020", "statement": "Toolchain identity is recorded exactly but is not called externally authenticated without an independent root.", "enforced_by": ["input_snapshot", "authorization"]},
    {"id": "CAP-INV-021", "statement": "Only the four registered local bounded claims may change from NOT_RUN or diagnostic status after a separately completed strict reduction; raw capture alone changes none.", "enforced_by": ["claim_boundary", "positive_eligibility", "state_machines"]},
    {"id": "CAP-INV-022", "statement": "All external refinement, F0, R11, K0/G0, Linux, Monitor, protection, performance, cost, and deployment claims remain false or open.", "enforced_by": ["claim_boundary", "authorization"]},
    {"id": "CAP-INV-023", "statement": "TLA+ is not an input to this capture architecture and remains a post-freeze validation backend.", "enforced_by": ["reasoning_profile", "authorization"]},
    {"id": "CAP-INV-024", "statement": "The guardian disarms only after observing a valid durable raw commit marker; supervisor failure cannot leave a candidate descendant executing without a separately authorized guardian-owned incomplete record after populated-zero drain.", "enforced_by": ["PLAT-SUPERVISOR-GUARDIAN", "roles", "state_machines", "containment", "finalization"]},
    {"id": "CAP-INV-025", "statement": "A local capture never claims safety against a malicious capture-host kernel or root service.", "enforced_by": ["trust_boundary", "authorization"]},
    {"id": "CAP-INV-026", "statement": "The run deadline is at least the sum of component deadlines, all per-component drain bounds, and sealed supervisor overhead, and systemd enforces that same bound.", "enforced_by": ["resource_policy", "PLAT-MONOTONIC-DEADLINE"]},
    {"id": "CAP-INV-027", "statement": "Component memory.max plus the guardian/host reserve never exceeds probed VM memory; supervisor memory.low is contained within that reserve; exact-state spill is capped by a per-component loop filesystem with a host free-space reserve; RAM or disk exhaustion cannot make the trusted supervisor commit a complete receipt.", "enforced_by": ["resource_policy", "PLAT-CAPACITY-RESERVE", "PLAT-SUPERVISOR-GUARDIAN", "PLAT-MOUNT-NAMESPACE"]},
    {"id": "CAP-INV-028", "statement": "Every candidate component uses one immutable toolchain image digest for the entire run; live host /usr is not an admissible production capture input.", "enforced_by": ["PLAT-IMMUTABLE-TOOLCHAIN", "input_snapshot"]},
    {"id": "CAP-INV-029", "statement": "A prior-boot durable run intent without a valid commit marker can produce only BOOT_INTERRUPTED and a guardian incomplete disposition.", "enforced_by": ["PLAT-BOOT-RECONCILIATION", "finalization", "state_machines"]},
    {"id": "CAP-INV-030", "statement": "Offline capture controls add no instruction, field, allocation, lock, hash, JSON parse, global scan, or synchronous trace to the production Linux scheduler or Monitor hot path.", "enforced_by": ["performance_boundary", "authorization"]}
