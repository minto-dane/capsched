{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "domainlease-evidence-capsule-v1-core-manifest.schema.json",
  "title": "DomainLease Evidence Capsule v1 Core Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "hash_algorithm",
    "capsule_id",
    "core"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "hash_algorithm": {
      "const": "sha256"
    },
    "capsule_id": {
      "$ref": "#/$defs/sha256"
    },
    "core": {
      "type": "object",
      "required": [
        "schema_version",
        "capsule_kind",
        "created_at",
        "collector_identity",
        "collector_implementation_sha256",
        "producer_identity",
        "capture_source_root_id",
        "capture_limits",
        "target_claims",
        "experiment_contract",
        "source_identity",
        "declared_environment",
        "completeness_rule",
        "objects"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "capsule_kind": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "collector_identity": {
          "$ref": "#/$defs/token"
        },
        "collector_implementation_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "producer_identity": {
          "$ref": "#/$defs/token"
        },
        "capture_source_root_id": {
          "$ref": "#/$defs/token"
        },
        "capture_limits": {
          "type": "object",
          "required": [
            "max_request_bytes",
            "max_objects",
            "max_object_bytes",
            "max_total_bytes"
          ],
          "properties": {
            "max_request_bytes": {
              "$ref": "#/$defs/positiveInteger"
            },
            "max_objects": {
              "$ref": "#/$defs/positiveInteger"
            },
            "max_object_bytes": {
              "$ref": "#/$defs/positiveInteger"
            },
            "max_total_bytes": {
              "$ref": "#/$defs/positiveInteger"
            }
          },
          "additionalProperties": false
        },
        "target_claims": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/token"
          }
        },
        "experiment_contract": {
          "type": "object",
          "required": [
            "id",
            "object_path",
            "sha256"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/token"
            },
            "object_path": {
              "$ref": "#/$defs/safePath"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          },
          "additionalProperties": false
        },
        "source_identity": {
          "type": "object"
        },
        "declared_environment": {
          "type": "object"
        },
        "completeness_rule": {
          "type": "object",
          "required": [
            "allow_extra_files",
            "expected_files"
          ],
          "properties": {
            "allow_extra_files": {
              "const": false
            },
            "expected_files": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/safePath"
              }
            }
          },
          "additionalProperties": false
        },
        "objects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/objectRow"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]*$"
    },
    "safePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*//)(?!.*\\\\)(?!\\.{1,2}(?:/|$))(?!.*/\\.{1,2}(?:/|$))[A-Za-z0-9._+-]+(?:/[A-Za-z0-9._+-]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "objectRow": {
      "type": "object",
      "required": [
        "capsule_path",
        "role",
        "media_type",
        "required",
        "captured",
        "producer_path_or_source",
        "capture_method"
      ],
      "properties": {
        "capsule_path": {
          "$ref": "#/$defs/safePath"
        },
        "role": {
          "$ref": "#/$defs/token"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "captured": {
          "type": "boolean"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "producer_path_or_source": {
          "type": "string",
          "minLength": 1
        },
        "capture_method": {
          "enum": [
            "single_open_fd_copy",
            "missing_optional"
          ]
        },
        "source_git": {
          "$ref": "#/$defs/sourceGit"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "captured": {
                "const": true
              }
            },
            "required": [
              "captured"
            ]
          },
          "then": {
            "required": [
              "size_bytes",
              "sha256"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "size_bytes"
                  ]
                },
                {
                  "required": [
                    "sha256"
                  ]
                }
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "sourceGit": {
      "type": "object",
      "required": [
        "mode",
        "object_id",
        "size_bytes",
        "sha256"
      ],
      "properties": {
        "mode": {
          "enum": [
            "100644",
            "100755"
          ]
        },
        "object_id": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
