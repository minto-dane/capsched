{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "domainlease-ai-state-v2.schema.json",
  "title": "DomainLease-Linux Compact Current State",
  "type": "object",
  "required": [
    "schema_version",
    "updated",
    "project",
    "architecture_intent",
    "core_concepts",
    "accepted_invariants",
    "design_boundaries",
    "completion",
    "evidence",
    "planned_tracks",
    "open_questions",
    "next_actions",
    "canonical_files"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "project": {
      "type": "object",
      "required": [
        "name",
        "purpose",
        "current_phase",
        "publication",
        "control_repository",
        "superproject",
        "linux_source",
        "linux_patch_queue"
      ],
      "properties": {
        "name": {
          "const": "DomainLease-Linux"
        },
        "legacy_name": {
          "type": "string"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "current_phase": {
          "enum": [
            "f0_v5_c4_authority_capture_g1_g5_closed"
          ]
        },
        "publication": {
          "type": "object",
          "required": [
            "github_visibility",
            "decision_date",
            "secrets_allowed",
            "scope"
          ],
          "properties": {
            "github_visibility": {
              "const": "public_intentional"
            },
            "decision_date": {
              "type": "string",
              "format": "date"
            },
            "secrets_allowed": {
              "const": false
            },
            "scope": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "control_repository": {
          "$ref": "#/$defs/gitControlRepository"
        },
        "superproject": {
          "type": "object",
          "required": [
            "remote",
            "checkpoint_resolution",
            "recorded_parent_baseline_revision"
          ],
          "properties": {
            "remote": {
              "type": "string",
              "minLength": 1
            },
            "checkpoint_resolution": {
              "const": "default_branch_gitlink"
            },
            "recorded_parent_baseline_revision": {
              "$ref": "#/$defs/gitObject"
            }
          },
          "additionalProperties": false
        },
        "linux_source": {
          "type": "object",
          "required": [
            "repository",
            "branch",
            "work_revision",
            "work_tree",
            "upstream_base_revision",
            "fetched_upstream_revision",
            "upstream_ref",
            "upstream_remote",
            "status"
          ],
          "properties": {
            "repository": {
              "type": "string"
            },
            "branch": {
              "type": "string"
            },
            "work_revision": {
              "$ref": "#/$defs/gitObject"
            },
            "work_tree": {
              "$ref": "#/$defs/gitObject"
            },
            "upstream_base_revision": {
              "$ref": "#/$defs/gitObject"
            },
            "fetched_upstream_revision": {
              "$ref": "#/$defs/gitObject"
            },
            "upstream_ref": {
              "type": "string"
            },
            "upstream_remote": {
              "type": "string"
            },
            "status": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "linux_patch_queue": {
          "allOf": [
            {
              "$ref": "#/$defs/gitReference"
            },
            {
              "type": "object",
              "required": [
                "repository",
                "branch",
                "replay_base_revision",
                "replay_work_revision",
                "replay_scope"
              ],
              "properties": {
                "repository": {
                  "type": "string"
                },
                "branch": {
                  "type": "string"
                },
                "replay_base_revision": {
                  "$ref": "#/$defs/gitObject"
                },
                "replay_work_revision": {
                  "$ref": "#/$defs/gitObject"
                },
                "replay_scope": {
                  "const": "historical_l0_endpoint_not_current_experimental_head"
                }
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "architecture_intent": {
      "type": "object",
      "required": [
        "threat",
        "hard_boundary",
        "granularity",
        "cluster_shape",
        "linux_role",
        "monitor_role"
      ],
      "properties": {
        "threat": {
          "type": "string",
          "minLength": 1
        },
        "hard_boundary": {
          "type": "string",
          "minLength": 1
        },
        "granularity": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "cluster_shape": {
          "type": "string"
        },
        "linux_role": {
          "type": "string"
        },
        "monitor_role": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "core_concepts": {
      "type": "object"
    },
    "accepted_invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/idText"
      }
    },
    "design_boundaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "completion": {
      "type": "object",
      "required": [
        "v1_claim_inventory_complete",
        "local_contract_coverage",
        "final_compositional_model_complete",
        "linux_implementation_complete",
        "monitor_implementation_complete",
        "protection_evidenced",
        "cost_efficiency_evidenced",
        "deployment_ready"
      ],
      "properties": {
        "v1_claim_inventory_complete": {
          "const": true
        },
        "local_contract_coverage": {
          "type": "string"
        },
        "final_compositional_model_complete": {
          "const": false
        },
        "linux_implementation_complete": {
          "const": false
        },
        "monitor_implementation_complete": {
          "const": false
        },
        "protection_evidenced": {
          "const": false
        },
        "cost_efficiency_evidenced": {
          "const": false
        },
        "deployment_ready": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "policy",
        "contract_status",
        "tooling_status",
        "reviewed_positive_promotion_credit",
        "reviewed_negative_results",
        "exact_git_objects",
        "codex_security_scan_required",
        "claim_specific_results",
        "local_candidate_checkpoint",
        "authority_capture_contract"
      ],
      "properties": {
        "policy": {
          "const": "ADR-0013_validator_owned_immutable_capsules"
        },
        "contract_status": {
          "const": "defined"
        },
        "tooling_status": {
          "enum": [
            "not_implemented",
            "partial",
            "implemented"
          ]
        },
        "reviewed_positive_promotion_credit": {
          "const": "needs_revalidation"
        },
        "reviewed_negative_results": {
          "const": "blocking_signal_pending_reproduction"
        },
        "exact_git_objects": {
          "const": "retained_reproducible_input"
        },
        "codex_security_scan_required": {
          "const": false
        },
        "codex_security_scan_note": {
          "type": "string"
        },
        "claim_specific_results": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "claim_id",
              "run_id",
              "capsule_id",
              "validator_result_sha256",
              "decision_sha256",
              "evidence_level",
              "allowed_transition"
            ],
            "properties": {
              "claim_id": {
                "type": "string",
                "minLength": 1
              },
              "run_id": {
                "type": "string",
                "minLength": 1
              },
              "capsule_id": {
                "$ref": "#/$defs/sha256"
              },
              "validator_result_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "decision_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "evidence_level": {
                "enum": [
                  "EC0",
                  "EC1",
                  "EC2",
                  "EC3"
                ]
              },
              "allowed_transition": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "local_candidate_checkpoint": {
          "type": "object",
          "required": [
            "artifact_id",
            "status",
            "fast_validator_status",
            "full_validator_status",
            "hostile_case_counts",
            "component_receipt_capture_authority",
            "authority_disjoint_capture",
            "authorization"
          ],
          "properties": {
            "artifact_id": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "const": "pre_full_local_checkpoint"
            },
            "fast_validator_status": {
              "const": "COMPLETE_LOCAL_C4_FAST_REGRESSION_ONLY"
            },
            "full_validator_status": {
              "const": "NOT_RUN"
            },
            "hostile_case_counts": {
              "type": "object",
              "required": ["child", "parent", "runner", "total"],
              "properties": {
                "child": {"type": "integer", "minimum": 1},
                "parent": {"type": "integer", "minimum": 1},
                "runner": {"type": "integer", "minimum": 1},
                "total": {"type": "integer", "minimum": 1}
              },
              "additionalProperties": false
            },
            "component_receipt_capture_authority": {
              "const": "candidate_validator_local_process"
            },
            "authority_disjoint_capture": {
              "const": false
            },
            "authorization": {
              "type": "object",
              "required": [
                "F0_local_acceptance",
                "external_R11_review",
                "G0_authorized",
                "self_authorization",
                "protection_claim"
              ],
              "properties": {
                "F0_local_acceptance": {"const": false},
                "external_R11_review": {"const": false},
                "G0_authorized": {"const": false},
                "self_authorization": {"const": false},
                "protection_claim": {"const": false}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "authority_capture_contract": {
          "type": "object",
          "required": [
            "artifact_id",
            "canonical_sha256",
            "evidence_level",
            "status",
            "hostile_mutation_cases",
            "derived_semantic_cases",
            "closed_gates",
            "remaining_gates",
            "root_supervisor_implemented",
            "target_platform_probe_passed",
            "hostile_fault_fixtures_passed",
            "reduction_boundary_implemented",
            "immutable_toolchain",
            "short_regression",
            "full_capture_run",
            "real_reduction_run"
          ],
          "properties": {
            "artifact_id": {
              "const": "f0-c4-authority-disjoint-capture-contract-v1"
            },
            "canonical_sha256": {
              "const": "14ca4b5424f448462ff0868689f278f412ee43fe2d32d8372a8cacc78d4fd075"
            },
            "evidence_level": {
              "const": "EC0"
            },
            "status": {
              "const": "local_mechanism_g1_g5_closed_g6_g7_pending"
            },
            "hostile_mutation_cases": {
              "const": 153
            },
            "derived_semantic_cases": {
              "const": 13
            },
            "closed_gates": {
              "const": [
                "C4CAP-G1-CONTRACT",
                "C4CAP-G2-HOSTILE",
                "C4CAP-G3-SUPERVISOR",
                "C4CAP-G4-PLATFORM",
                "C4CAP-G5-FAULTS"
              ]
            },
            "remaining_gates": {
              "const": [
                "C4CAP-G6-CAPTURE",
                "C4CAP-G7-REDUCTION"
              ]
            },
            "root_supervisor_implemented": {
              "const": true
            },
            "target_platform_probe_passed": {
              "const": true
            },
            "hostile_fault_fixtures_passed": {
              "const": true
            },
            "reduction_boundary_implemented": {
              "const": true
            },
            "immutable_toolchain": {
              "type": "object",
              "required": ["format", "sha256", "mounted_read_only"],
              "properties": {
                "format": {"const": "erofs"},
                "sha256": {
                  "const": "4fadeb77fe5019e0a9ea22ea43b79f07923f587fa90b9636164ab9e396de34ac"
                },
                "mounted_read_only": {"const": true}
              },
              "additionalProperties": false
            },
            "short_regression": {
              "type": "object",
              "required": [
                "launcher_basic_cases",
                "launcher_hostile_cases",
                "snapshot_hostile_cases",
                "supervisor_components",
                "guardian_cases",
                "reducer_cases"
              ],
              "properties": {
                "launcher_basic_cases": {"const": 1},
                "launcher_hostile_cases": {"const": 10},
                "snapshot_hostile_cases": {"const": 5},
                "supervisor_components": {"const": 5},
                "guardian_cases": {"const": 3},
                "reducer_cases": {"const": 3}
              },
              "additionalProperties": false
            },
            "full_capture_run": {
              "const": false
            },
            "real_reduction_run": {
              "const": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "planned_tracks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/orderedWork"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "blocking",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "blocking": {
            "type": "boolean"
          },
          "text": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "next_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/orderedWork"
      }
    },
    "canonical_files": {
      "type": "object",
      "required": [
        "state",
        "state_schema",
        "state_checker",
        "handoff",
        "event_log",
        "current_decision",
        "evidence_decision",
        "goal_audit",
        "evidence_contract",
        "active_plan",
        "assurance_case",
        "assurance_register"
      ],
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitObject": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "gitReference": {
      "type": "object",
      "required": [
        "revision",
        "remote"
      ],
      "properties": {
        "revision": {
          "$ref": "#/$defs/gitObject"
        },
        "remote": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "gitControlRepository": {
      "type": "object",
      "required": [
        "branch",
        "semantic_baseline_revision",
        "reviewed_lineage_revision",
        "stable_main_revision",
        "remote"
      ],
      "properties": {
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "semantic_baseline_revision": {
          "$ref": "#/$defs/gitObject"
        },
        "reviewed_lineage_revision": {
          "$ref": "#/$defs/gitObject"
        },
        "stable_main_revision": {
          "$ref": "#/$defs/gitObject"
        },
        "remote": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "idText": {
      "type": "object",
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "orderedWork": {
      "type": "object",
      "required": [
        "order",
        "id",
        "status"
      ],
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        },
        "next_artifact": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
